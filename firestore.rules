rules_version = '2';

/* Il registro del parco lo leggono e lo scrivono SOLO le persone che hanno
   fatto l'accesso con utente e password. Chi non è entrato non vede niente,
   nemmeno conoscendo l'indirizzo del progetto. */
service cloud.firestore {
  match /databases/{database}/documents {

    match /parchi/{parco} {
      allow read, write: if request.auth != null;

      match /{documento=**} {
        allow read, write: if request.auth != null;
      }
    }

    // tutto il resto resta chiuso
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
